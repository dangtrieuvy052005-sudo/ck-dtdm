# 6. Internal DNS Server (Bind9)
# File db.cloud.local (Zone file) đáp ứng đủ bản ghi yêu cầu

$TTL 1H
@   IN SOA  ns.cloud.local. admin.cloud.local. ( 1 1H 15M 1W 1H )
    IN NS   ns.cloud.local.
ns  IN A    127.0.0.1

; Bản ghi A theo yêu cầu đề bài
web-frontend-server IN A 10.10.10.10
app-backend        IN A 10.10.10.11
minio              IN A 10.10.10.12
keycloak           IN A 10.10.10.13
